MYCE_CONDITION_ENGINE=${MYCE_CONDITION_ENGINE:-${MYCE_CONDITION_BASE:-podman}}
MYCE_CONDITION_BASE=podman
MYCE_EMPTY_MINUS=${MYCE_EMPTY_VAR-podman}
MYCE_EMPTY_COLON=${MYCE_EMPTY_VAR:-podman}

[IF $MYCE_CONDITION_ENGINE == "podman"]
    RESULT=podman-selected
[ELSE IF $MYCE_CONDITION_ENGINE == "docker"]
    RESULT=docker-selected
[ELSE]
    RESULT=unknown-selected
[FI]

echo.result=echo "$RESULT"

[IF $MYCE_EMPTY_MINUS == ""]
    EMPTY_MINUS_RESULT=empty
[ELSE]
    EMPTY_MINUS_RESULT=defaulted
[FI]

[IF $MYCE_EMPTY_COLON == "podman"]
    EMPTY_COLON_RESULT=defaulted
[ELSE]
    EMPTY_COLON_RESULT=empty
[FI]

echo.empty-minus=echo "$EMPTY_MINUS_RESULT"
echo.empty-colon=echo "$EMPTY_COLON_RESULT"
